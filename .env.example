# Local development only. This file is safe to commit; .env is ignored.
MATRIX_DEPLOYMENT_MODE=local
MATRIX_STORAGE_ROOT=runtime
MATRIX_LOCAL_USERNAME=owner
MATRIX_LOCAL_PASSWORD=change-me-before-sharing
MATRIX_LOCAL_TENANT_ID=local-demo
MATRIX_SESSION_SECRET=local-development-only-change-before-sharing
MATRIX_COOKIE_SECURE=false
# Required only when the Avinash CRM gateway calls this API; never expose it to a browser.
MATRIX_SERVICE_AUTH_SECRET=
MATRIX_SERVICE_AUTH_MAX_AGE_SECONDS=300
# Header-only suggestions are user-triggered. Leave blank unless separately approved.
OPENAI_API_KEY=
MATRIX_SCHEMA_AI_ENABLED=true
MATRIX_SCHEMA_AI_MODEL=gpt-4o-mini
# Optional bounded research review. It sends only company, sector, district and
# geography status; it cannot change classes or exports. Enable only after a
# spend review; leave off for deterministic processing.
MATRIX_AI_ENABLED=false
MATRIX_AI_ALLOW_PII=false
MATRIX_AI_MAX_CALLS=0
