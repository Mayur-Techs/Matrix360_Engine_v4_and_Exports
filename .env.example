OPENAI_API_KEY=
MATRIX_LOCAL_USERNAME=owner
MATRIX_LOCAL_PASSWORD=replace-with-a-long-local-password
MATRIX_LOCAL_TENANT_ID=local-demo
MATRIX_SESSION_SECRET=replace-with-a-long-random-session-secret
MATRIX_DEPLOYMENT_MODE=local
MATRIX_COOKIE_SECURE=false
MATRIX_STORAGE_ROOT=./runtime
MATRIX_MAX_UPLOAD_BYTES=536870912
MATRIX_AI_PROVIDER=openai
MATRIX_AI_MODEL=gpt-4o-mini
MATRIX_AI_REVIEW_MODEL=gpt-4o
# Leave these false/zero unless a data-transfer review and a spend limit are approved.
MATRIX_AI_ENABLED=false
MATRIX_AI_MAX_CALLS=0
MATRIX_AI_ALLOW_PII=false

