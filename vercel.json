{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "apps/web",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://matrix360-crawler-api.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://matrix360-crawler-api.onrender.com/health"
    },
    {
      "source": "/healthz",
      "destination": "https://matrix360-crawler-api.onrender.com/healthz"
    },
    {
      "source": "/((?!api/|health|healthz).*)",
      "destination": "/index.html"
    }
  ]
}
