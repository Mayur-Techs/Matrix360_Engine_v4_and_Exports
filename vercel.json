{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://matrix360-api.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://matrix360-api.onrender.com/health"
    },
    {
      "source": "/assets/:path*",
      "destination": "/apps/web/assets/:path*"
    },
    {
      "source": "/styles.css",
      "destination": "/apps/web/styles.css"
    },
    {
      "source": "/overrides.css",
      "destination": "/apps/web/overrides.css"
    },
    {
      "source": "/app.js",
      "destination": "/apps/web/app.js"
    },
    {
      "source": "/favicon.svg",
      "destination": "/apps/web/favicon.svg"
    },
    {
      "source": "/",
      "destination": "/apps/web/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/apps/web/index.html"
    }
  ]
}
